datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id            String   @id @default(uuid())
  name          String
  brand         String
  category      String
  price         Float
  size          String
  skinTypes     String[]
  concerns      String[]
  ingredients   String[]
  texture       String
  fragranceFree Boolean  @default(false)
  rating        Float    @default(0.0)
  description   String
  imageUrl      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([price])
  @@index([rating])
}
